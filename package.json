{
  "name": "bubblesjs",
  "private": true,
  "keywords": [
    "@bubblesjs/utils",
    "@bubblesjs/vue-ai-chart",
    "@bubblesjs/vue-annotation",
    "@bubblesjs/vue-infinite-scroll",
    "@rebubblesjs/request",
    "ai-chart",
    "alova",
    "annotation",
    "axios",
    "bubbles",
    "bubbles-utils",
    "bubblesjs",
    "create-bubbles",
    "infinite-scroll",
    "monorepo",
    "react-template",
    "request",
    "template",
    "utils",
    "vue",
    "vue-components",
    "vue3"
  ],
  "homepage": "",
  "bugs": {
    "url": "git+https://github.com/435012357/bubblesjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/435012357/bubblesjs.git"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format": "vp fmt --write .",
    "lint": "vp lint .",
    "check": "vp check",
    "typecheck": "tsc -p scripts --noEmit && pnpm -r --parallel run typecheck",
    "docs": "pnpm --filter=docs run docs",
    "docs:build": "pnpm --filter=docs run docs:build",
    "docs:preview": "pnpm --filter=docs run preview",
    "docs-serve": "pnpm --filter=docs run preview",
    "build": "pnpm -r --filter=./packages/* run build",
    "dev": "pnpm -r --parallel --filter=./packages/* run dev",
    "release": "pnpm --recursive --stream build && changeset publish",
    "ci-publish": "tsx scripts/publishCI.ts",
    "ci-docs": "pnpm build && pnpm docs:build",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@commitlint/config-conventional": "^21.2.2",
    "lefthook": "^2.1.10",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged --concurrent false"
  }
}
