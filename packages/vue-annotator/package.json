{
  "name": "@bubblesjs/vue-annotation",
  "version": "0.0.4",
  "private": false,
  "description": "A starter for creating a Vue component library.",
  "homepage": "https://github.com/author/library#readme",
  "bugs": {
    "url": "git+https://github.com/435012357/bubblesjs/issues"
  },
  "license": "MIT",
  "author": "Author Name <author.name@mail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/435012357/bubblesjs.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "unocss \"src/**/*.vue\" -o dist/style.css && vp pack",
    "dev": "vp pack --watch",
    "play": "vp dev",
    "test": "vp test",
    "typecheck": "vue-tsc --noEmit",
    "release": "bumpp && pnpm publish",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@flatten-js/interval-tree": "^2.0.3",
    "es-toolkit": "^1.52.0",
    "grapheme-splitter": "^1.0.4",
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@types/node": "^24.10.1",
    "@unocss/cli": "^66.5.10",
    "@unocss/eslint-plugin": "catalog:",
    "@unocss/postcss": "^66.5.10",
    "@unocss/preset-attributify": "^66.5.10",
    "@unocss/preset-wind3": "^66.5.10",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/browser-playwright": "catalog:",
    "bumpp": "^10.3.2",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "unocss": "^66.5.10",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-vue": "catalog:",
    "vue": "^3.5.25"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
