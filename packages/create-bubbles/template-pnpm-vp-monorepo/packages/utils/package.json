{
  "name": "@bubblesjs/utils",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo 模板中的共享 TypeScript 工具包示例。",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp run bundle",
    "dev": "vp pack --watch",
    "test": "vp test run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "vp pack && tsc -p tests/consumer/tsconfig.json --noEmit && node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
