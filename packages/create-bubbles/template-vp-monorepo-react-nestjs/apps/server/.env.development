STORAGE_BUCKET=uploads

# ==================== BullMQ 基础连接 ====================

# BullMQ 使用的 Redis 主机地址；本地开发通常为 localhost
QUEUE_REDIS_HOST=localhost
# Redis 服务端口；Redis 默认端口为 6379
QUEUE_REDIS_PORT=6379
# Redis ACL 用户名；留空表示使用 Redis 的 default 用户
QUEUE_REDIS_USERNAME=
# Redis 密码；生产环境应通过安全方式注入，不要提交真实密码
QUEUE_REDIS_PASSWORD=ml
# Redis 逻辑数据库编号；使用 DB 1，避免与默认 DB 0 的数据混在一起
QUEUE_REDIS_DB=1
# BullMQ 在 Redis 中创建键时使用的统一前缀
# 用于区分不同项目和环境，例如开发、测试、生产环境
QUEUE_PREFIX=bubbles:development:queue


# ==================== Worker 开关 ====================

# 当前 NestJS 进程是否启动 BullMQ Worker 并消费任务
# true：既可以投递任务，也会执行任务
# false：只投递任务，不在当前进程中执行任务
QUEUE_WORKER_ENABLED=true


# ==================== 默认任务策略 ====================

# 单个任务最多尝试执行的总次数
# 3 表示首次执行失败后最多再重试 2 次，共执行最多 3 次
QUEUE_DEFAULT_ATTEMPTS=3

# 任务失败后的重试退避基础延迟，单位为毫秒
# 1000 表示基础延迟为 1 秒
# 实际是固定延迟还是指数递增，取决于代码中的 backoff 类型配置
QUEUE_BACKOFF_DELAY_MS=1000

# 已完成任务记录的最长保留时间，单位为秒
# 86400 秒等于 24 小时，超过后可从 Redis 中清理
QUEUE_COMPLETED_AGE_SECONDS=86400

# Redis 中最多保留的已完成任务记录数量
# 即使任务未超过保留时间，也只保留最近约 1000 条
QUEUE_COMPLETED_COUNT=1000

# 失败任务记录的最长保留时间，单位为秒
# 604800 秒等于 7 天，便于排查近期失败原因
QUEUE_FAILED_AGE_SECONDS=604800

# Redis 中最多保留的失败任务记录数量
# 防止失败记录持续累积，占用过多 Redis 内存
QUEUE_FAILED_COUNT=5000
