NODE_ENV=development
JWT_SECRET=development_jwt_secret_change_me

DATABASE_URL=postgresql://postgres:ml@localhost:5432/postgres
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=ml

LLM_API_URL=https://api-inference.modelscope.cn/v1
LLM_API_MODEL=deepseek-ai/DeepSeek-V3.2  
##ZhipuAI/GLM-5.1
LLM_API_KEY=ms-6c0d8bc9-ed99-4515-81f3-db1341fe9e76


# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ml
REDIS_DB=0


# JWT的签名密钥 服务器签发access token 使用它签名 整整token shi
JWT_ACCESS_SECRET=oM1FmlgA-tpflskKz5jZRYf2-_QK-aPhjtboFYaqTtlqB4RNgWUFNsp3irMUUdJF
# JWT 的签发者，对应 JWT 中的 iss 字段：
JWT_ISSUER=bubbles-auth
# 验证 Token 时，服务器会检查它是不是由 bubbles-auth 签发的。它是标识符，不是密码。 JWT 的目标使用者，对应 aud 字段
# 表示这个 Token 是给 bubbles-api 使用的，避免一个系统签发的 JWT 被误用到另一个系统。
JWT_AUDIENCE=bubbles-api
# Access Token 的有效时间：
JWT_ACCESS_TTL_SECONDS=600
# JWT 时间校验的允许误差：
JWT_CLOCK_TOLERANCE_SECONDS=30


# Refresh Token 的服务端“椒值”，通常用于计算哈希：
REFRESH_TOKEN_PEPPER=ON-ECMSvcmjVryktpp-1BLpDl3r7Sl63-GXyy1uto2_1AbqCbNOndIfdtuBVe1o_
# Refresh Token 的有效时间： 30 天
REFRESH_TOKEN_TTL_SECONDS=2592000
# 保存 Refresh Token 的 Cookie 名称，浏览器中大致是：
# 生产环境如果使用 __Host- 安全前缀，可以改成： __Host-refresh_token
# REFRESH_COOKIE_PATH=/
# REFRESH_COOKIE_SECURE=true
# 并且不能设置 Domain。
REFRESH_COOKIE_NAME=refresh_token
# Cookie 只会自动发送给 /auth 路径下的接口 这样可以减少 Refresh Token 暴露给无关接口的机会。
REFRESH_COOKIE_PATH=/auth
# 表示这个 Cookie 不强制要求 HTTPS，适合本地 HTTP 开发
REFRESH_COOKIE_SECURE=false

# 认证状态在当前服务进程的本地内存中缓存
# 例如服务器查到“用户正常、会话有效”，可以缓存 30 秒，避免每个请求都查询数据库或 Redis。
# 本地缓存意味着每个 NestJS 实例都有自己的缓存，所以还需要下面的失效通知机制。
AUTH_LOCAL_CACHE_TTL_MS=30000

# 
AUTH_TOMBSTONE_TTL_SECONDS=900

# 当修改密码或者踢人的时候通过这个通道 通知用户失效
AUTH_EVENT_CHANNEL=auth-state:invalidate
