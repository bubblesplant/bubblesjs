{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "bun"],
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist", "drizzle"]
}
