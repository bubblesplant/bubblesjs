{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:node": "tsx watch src/index.ts",
    "dev:bun": "bun --no-env-file --watch src/index.bun.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:worker:node": "tsx watch src/worker.ts",
    "dev:worker:bun": "bun --no-env-file --watch src/worker.ts",
    "build": "vp pack",
    "start": "node dist/index.mjs",
    "start:node": "node dist/index.mjs",
    "start:bun": "bun --no-env-file dist/index.bun.mjs",
    "start:worker": "node dist/worker.mjs",
    "start:worker:node": "node dist/worker.mjs",
    "start:worker:bun": "bun --no-env-file dist/worker.mjs",
    "test": "vp test run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "bullmq": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "ioredis": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
